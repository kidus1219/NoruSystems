# Copy to backend/.env and adjust. Every value below is optional --
# the defaults run the project on SQLite with no configuration at all.

SECRET_KEY=dev-insecure-key-change-me
DEBUG=1
ALLOWED_HOSTS=*
TIME_ZONE=UTC

# SQLite (default). Swap for Postgres by changing this single line:
# DATABASE_URL=postgres://hotel:hotel@localhost:5432/hotel
# DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
